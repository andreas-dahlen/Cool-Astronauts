{
  "name": "cool-astronauts",
  "version": "1.0.0",
  "description": "REST API with node.js and dynamoDB",
  "author": "Cool Astronauts",
  "type": "module",
  "main": "src/server.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --env-file=../.env ./node_modules/vitest/vitest.mjs --silent=passed-only",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file=../.env dist/server.js",
    "cool": "npm run build && npm run start"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1140.0",
    "@aws-sdk/lib-dynamodb": "^3.1139.0",
    "@project/shared": "file:../shared",
    "@types/supertest": "^7.2.1",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "supertest": "^7.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
